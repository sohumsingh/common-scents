# Copy this file to .env.local and fill in the values from your Supabase
# project (Project Settings → API). .env.local is never committed.

# Public: safe to expose in the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Secret: server only. Used for admin tasks and seeding. Never share or commit.
SUPABASE_SECRET_KEY=sb_secret_xxx

# Server only. Lets Vercel's daily cron call /api/keep-alive (keeps the free
# Supabase project from pausing). Set it in Vercel; not needed locally.
CRON_SECRET=a-long-random-string
