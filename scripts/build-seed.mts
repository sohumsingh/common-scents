/**
 * Builds supabase/seed.sql from the catalogue files in src/lib/catalogue.
 *
 *   npm run db:seed:build
 *
 * The code catalogue stays the single source until the storefront reads from
 * the database; re-run this whenever it changes. Output is idempotent: it
 * upserts, so running the seed twice leaves one copy of everything.
 */
import { writeFileSync } from "node:fs";
import { fileURLToPath } from "node:url";
import { brands } from "../src/lib/catalogue/brands.ts";
import { occasions } from "../src/lib/catalogue/occasions.ts";
import { products } from "../src/lib/catalogue/products.ts";
import { finderProfiles } from "../src/lib/catalogue/finder-profile.ts";
import { wearGuides } from "../src/lib/catalogue/wear.ts";

/** Editorial "Trending Now" order (mirrors getCuratedTrending in service.ts). */
const TRENDING = [
  "lattafa-khamrah-edp",
  "afnan-9pm-edp",
  "ysl-black-opium-edp",
  "armaf-cdnim-edt",
  "dior-sauvage-edp",
  "versace-eros-edp",
];

const text = (value: string | null | undefined) =>
  value === null || value === undefined ? "null" : `'${value.replace(/'/g, "''")}'`;
const num = (value: number | null | undefined) => (value === null || value === undefined ? "null" : String(value));
const arr = (values: string[], type = "text") =>
  values.length ? `array[${values.map(text).join(", ")}]::${type}[]` : `'{}'::${type}[]`;

const rows = (table: string, columns: string[], values: string[][], conflict: string, update: string[]) =>
  `insert into public.${table} (${columns.join(", ")}) values\n` +
  values.map((row) => `  (${row.join(", ")})`).join(",\n") +
  `\non conflict (${conflict}) do ${
    update.length ? `update set ${update.map((column) => `${column} = excluded.${column}`).join(", ")}` : "nothing"
  };\n`;

const out: string[] = [
  "-- Generated by scripts/build-seed.mts from src/lib/catalogue. Do not edit by hand.",
  `-- ${products.length} products, ${brands.length} brands, ${occasions.length} occasions.`,
  "begin;",
  "",
];

out.push(
  rows(
    "occasions",
    ["slug", "name", "short_name", "tagline", "description", "question", "accent", "wash", "sort_order"],
    occasions.map((o) => [text(o.slug), text(o.name), text(o.shortName), text(o.tagline), text(o.description), text(o.question), text(o.accent), text(o.wash), num(o.order)]),
    "slug",
    ["name", "short_name", "tagline", "description", "question", "accent", "wash", "sort_order"],
  ),
);

out.push(
  rows(
    "brands",
    ["slug", "name", "family"],
    brands.map((b) => [text(b.slug), text(b.name), text(b.family)]),
    "slug",
    ["name", "family"],
  ),
);

const productColumns = [
  "id", "slug", "brand_slug", "name", "full_name", "concentration", "gender",
  "price_zar", "compare_at_price_zar", "short_description", "description", "character",
  "notes_top", "notes_heart", "notes_base", "notes_status", "pricing_status", "stock_status",
  "added_at", "editorial_badge",
  "visual_accent", "visual_glass", "visual_wash", "visual_shape", "visual_cap", "image_src", "image_alt",
  "finder_characters", "finder_intensity",
  "wear_winter", "wear_spring", "wear_summer", "wear_autumn", "wear_day", "wear_longevity_hours",
  "is_published", "sort_order", "trending_rank",
];

out.push(
  rows(
    "products",
    productColumns,
    products.map((p, index) => {
      const finder = finderProfiles[p.id];
      const wear = wearGuides[p.id];
      if (!finder) throw new Error(`No finder profile for ${p.id}`);
      const trending = TRENDING.indexOf(p.id);
      return [
        text(p.id), text(p.slug), text(p.brandSlug), text(p.name), text(p.fullName), text(p.concentration), text(p.gender),
        num(p.priceZAR), num(p.compareAtPriceZAR), text(p.shortDescription), text(p.description), arr(p.character),
        arr(p.notes.top), arr(p.notes.heart), arr(p.notes.base), text(p.notesStatus), text(p.pricingStatus), text(p.stockStatus),
        text(p.addedAt), text(p.editorialBadge),
        text(p.visual.accent), text(p.visual.glass), text(p.visual.wash), text(p.visual.shape), text(p.visual.cap),
        text(p.image?.src), text(p.image?.alt),
        arr(finder.characters, "public.finder_character"), text(finder.intensity),
        num(wear?.seasons.winter), num(wear?.seasons.spring), num(wear?.seasons.summer), num(wear?.seasons.autumn),
        num(wear?.day), num(wear?.longevityHours),
        "true", num(index), trending === -1 ? "null" : num(trending + 1),
      ];
    }),
    "id",
    productColumns.filter((column) => column !== "id"),
  ),
);

out.push(
  rows(
    "product_occasions",
    ["product_id", "occasion_slug", "sort_order"],
    products.flatMap((p) => p.occasions.map((slug, index) => [text(p.id), text(slug), num(index)])),
    "product_id, occasion_slug",
    ["sort_order"],
  ),
);

out.push(
  rows(
    "product_variants",
    ["product_id", "id", "label", "size", "price_zar", "sort_order"],
    products.flatMap((p) => p.variants.map((v, index) => [text(p.id), text(v.id), text(v.label), text(v.size), num(v.priceZAR), num(index)])),
    "product_id, id",
    ["label", "size", "price_zar", "sort_order"],
  ),
);

out.push("commit;", "");

const target = fileURLToPath(new URL("../supabase/seed.sql", import.meta.url));
writeFileSync(target, out.join("\n"));
console.log(`Wrote ${target} — ${products.length} products.`);
